generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  STUDENT
  PARENT
  ADMIN
}

enum Level {
  SECONDARY
  UNIVERSITY
}

enum Exam {
  WAEC
  JAMB
}

enum Language {
  SIMPLE
  PIDGIN
}

enum QuestionType {
  MCQ
  THEORY
}

enum QuestionSource {
  CURATED
  AI
}

enum MasteryLabel {
  WEAK
  NEEDS_WORK
  STRONG
}

enum Plan {
  FREE
  UNLIMITED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role     @default(STUDENT)
  level        Level    @default(SECONDARY)
  createdAt    DateTime @default(now())
  profile      Profile?
  attempts     Attempt[]
  mastery      TopicMastery[]
  streak       Streak?
  wallet       Wallet?
  parentLinks  ParentLink[] @relation("StudentLinks")
}

model Profile {
  userId   String   @id
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam     @default(JAMB)
  examDate DateTime?
  subjects String   @default("English,Mathematics")
  language Language @default(SIMPLE)
}

model Question {
  id              String         @id @default(cuid())
  exam            Exam
  subject         String
  topic           String
  type            QuestionType
  stem            String
  optionsJson     String         @default("[]")
  answerKey       String         @default("")
  markingRubric   String         @default("")
  source          QuestionSource @default(CURATED)
  predictedRepeat Boolean        @default(false)
  attempts        Attempt[]
  @@index([exam, subject, topic])
}

model Attempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response     String   @default("")
  correct      Boolean  @default(false)
  theoryScore  Int?
  feedbackJson String   @default("{}")
  creditsSpent Int      @default(1)
  createdAt    DateTime @default(now())
  @@index([userId, questionId])
}

model TopicMastery {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  topic      String
  accuracy   Float        @default(0)
  label      MasteryLabel @default(WEAK)
  streakCount Int         @default(0)
  updatedAt  DateTime     @updatedAt
  @@unique([userId, subject, topic])
}

model Streak {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current         Int       @default(0)
  longest         Int       @default(0)
  lastStudyDate   DateTime?
  freezeAvailable Boolean   @default(true)
}

model Wallet {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditsLeft Int      @default(10)
  resetAt     DateTime @default(now())
  plan        Plan     @default(FREE)
}

model ParentLink {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  parentEmail String
  magicToken  String    @unique @default(cuid())
  verifiedAt  DateTime?
}
