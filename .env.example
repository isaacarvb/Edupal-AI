DB_FILE="./dev.db"
# Postgres (Supabase) — set to switch the whole app off SQLite, no code changes.
# Use the pooler URL (port 6543). Local dev stays on SQLite when empty.
# DATABASE_URL=""
NEXTAUTH_SECRET="local-dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"
AI_PROVIDER="local-templates"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
# AI tutor (Groq). Leave empty for local template mode.
# Get a key at console.groq.com, paste it in .env.local (gitignored, never committed).
GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# Or a full fallback chain (no code changes needed when Groq retires names):
# GROQ_MODELS="openai/gpt-oss-120b,moonshotai/kimi-k2-instruct"
# Prod later (ZeptoMail):
# SMTP_HOST="smtp.zeptomail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# PAYSTACK_SECRET_KEY=""
# Test mode key starts with sk_test_. Paste the real one in .env.local (gitignored).
# PAYSTACK_PLAN_AMOUNT_KOBO="100000"
# Owner admin (only this email can open /admin):
# ADMIN_EMAIL="isaacareo34@gmail.com"
